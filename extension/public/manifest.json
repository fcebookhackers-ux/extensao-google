{
  "manifest_version": 3,
  "name": "ModaRadar",
  "version": "0.1.0",
  "description": "Analisa concorrentes no Mercado Livre e Shopee em tempo real.",
  "action": {
    "default_title": "Analisar concorrência",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3001/*",
    "https://slktzwdfwvjlbozrtnrl.supabase.co/*",
    "https://www.mercadolivre.com/*",
    "https://produto.mercadolivre.com.br/*",
    "https://www.mercadolivre.com.br/*",
    "https://shopee.com.br/*",
    "https://www.shopee.com.br/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.mercadolivre.com/*",
        "https://produto.mercadolivre.com.br/*",
        "https://www.mercadolivre.com.br/*",
        "https://shopee.com.br/*",
        "https://www.shopee.com.br/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
